<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>SS_LightStrain</defName>
    <label>light strain</label>
    <description>Bright light irritates this Sightstealer's body. Stronger exposure slows movement and suppresses ordinary wound healing.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <label>stable</label>
      </li>
      <li>
        <minSeverity>0.5</minSeverity>
        <label>bright light</label>
        <statFactors>
          <MoveSpeed>0.88</MoveSpeed>
          <InjuryHealingFactor>0.65</InjuryHealingFactor>
        </statFactors>
      </li>
      <li>
        <minSeverity>1</minSeverity>
        <label>direct light</label>
        <statFactors>
          <MoveSpeed>0.68</MoveSpeed>
          <InjuryHealingFactor>0.15</InjuryHealingFactor>
        </statFactors>
      </li>
    </stages>
    <comps>
      <li Class="SightstealerColony.HediffCompProperties_LightSensitivity" />
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>SS_DarkRegeneration</defName>
    <label>dark regeneration</label>
    <description>Darkness accelerates this Sightstealer's recovery from ordinary injuries. The effect is strongest in deep darkness.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <label>ordinary healing</label>
      </li>
      <li>
        <minSeverity>0.5</minSeverity>
        <label>dark healing</label>
      </li>
      <li>
        <minSeverity>1</minSeverity>
        <label>deep-dark healing</label>
      </li>
    </stages>
    <comps>
      <li Class="SightstealerColony.HediffCompProperties_DarkRegeneration" />
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>SS_UmbralInvisibility</defName>
    <label>umbral invisibility</label>
    <description>This Sightstealer is psychically invisible to other pawns while deep darkness holds. Attacking or taking damage reveals them briefly.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Invisibility">
        <visibleToPlayer>true</visibleToPlayer>
        <fadeDurationTicks>30</fadeDurationTicks>
        <recoverFromDisruptedTicks>90</recoverFromDisruptedTicks>
        <affectedByDisruptor>true</affectedByDisruptor>
      </li>
      <li Class="SightstealerColony.HediffCompProperties_ConditionalInvisibility" />
      <li Class="HediffCompProperties_DisappearsOnDeath" />
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>SS_RitualBlindness</defName>
    <label>ritual blindness</label>
    <description>Psychic backlash has temporarily clouded this pawn's sight.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <stages>
      <li>
        <label>blinded by backlash</label>
        <capMods>
          <li>
            <capacity>Sight</capacity>
            <offset>-0.8</offset>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000~90000</disappearsAfterTicks>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>SS_RitualWound</defName>
    <label>ritual wound</label>
    <description>A failed offering left this pawn physically weakened.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <stages>
      <li>
        <label>weakened</label>
        <statFactors>
          <MoveSpeed>0.8</MoveSpeed>
          <Manipulation>0.8</Manipulation>
        </statFactors>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000~90000</disappearsAfterTicks>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>SS_RitualExaltation</defName>
    <label>ritual exaltation</label>
    <description>An exceptional offering left this Sightstealer unusually potent.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <stages>
      <li>
        <label>exceptional</label>
        <statFactors>
          <MoveSpeed>1.1</MoveSpeed>
          <Manipulation>1.1</Manipulation>
        </statFactors>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>90000~120000</disappearsAfterTicks>
      </li>
    </comps>
  </HediffDef>

</Defs>
